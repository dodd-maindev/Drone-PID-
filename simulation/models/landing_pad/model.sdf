<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="landing_pad">
    <static>true</static>
    <link name="link">
      <!-- Main Pad Base (Flat circular platform) -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>2.0</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <pose>0 0 0.01 0 0 0</pose>
      </collision>

      <!-- Dark circular base pad -->
      <visual name="base_visual">
        <pose>0 0 0.01 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>2.0</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.18 1</ambient>
          <diffuse>0.15 0.15 0.18 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Yellow Outer Warning Ring -->
      <visual name="ring_visual">
        <pose>0 0 0.021 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>1.85</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.75 0.05 1</ambient>
          <diffuse>0.95 0.75 0.05 1</diffuse>
        </material>
      </visual>

      <!-- Inner Inner Dark Ring -->
      <visual name="inner_pad_visual">
        <pose>0 0 0.024 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>1.65</radius>
            <length>0.005</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.18 0.20 0.24 1</ambient>
          <diffuse>0.18 0.20 0.24 1</diffuse>
        </material>
      </visual>

      <!-- White 'H' Mark - Left Bar -->
      <visual name="h_left">
        <pose>-0.45 0 0.028 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 1.2 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>

      <!-- White 'H' Mark - Right Bar -->
      <visual name="h_right">
        <pose>0.45 0 0.028 0 0 0</pose>
        <geometry>
          <box>
            <size>0.2 1.2 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>

      <!-- White 'H' Mark - Center Crossbar -->
      <visual name="h_cross">
        <pose>0 0 0.028 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8 0.2 0.005</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
